{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  // postgres.js 드라이버가 node:net/tls를 사용하므로 필요
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // NEIS(나이스) 공공데이터 API 키 — 학교 검색용 (공개 데이터라 vars로 관리)
  "vars": {
    "NEIS_API_KEY": "8c9b43b18cab4614847cba6989621588"
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // 프로덕션 커스텀 도메인 — zone(bktk.kr)이 같은 Cloudflare 계정에 있어야 한다
  "routes": [
    {
      "pattern": "api.bktk.kr",
      "custom_domain": true
    }
  ],
  // 수업 이미지·자료 저장소. 로컬(wrangler dev)에서는 Miniflare가 시뮬레이션하며
  // 데이터는 .wrangler/state/에 저장된다. 로컬 시드: pnpm r2:seed
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bktk"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}