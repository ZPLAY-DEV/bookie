{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  // postgres.js 드라이버가 node:net/tls를 사용하므로 필요
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // 수업 이미지·자료 저장소. 로컬(wrangler dev)에서는 Miniflare가 시뮬레이션하며
  // 데이터는 .wrangler/state/에 저장된다. 로컬 시드: pnpm r2:seed
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "media"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}